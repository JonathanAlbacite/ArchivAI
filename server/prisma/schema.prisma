generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   // "teacher" or "student"
  createdAt DateTime @default(now())

  taughtRooms       Room[]             @relation("TeacherRooms")
  enrolledRooms     RoomStudent[]
  sessions          CampaignSession[]
  lessonModules     LessonModule[]
  chatConversations ChatConversation[]
}

model Room {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  roomCode    String   @unique
  teacherId   Int
  createdAt   DateTime @default(now())

  teacher   User          @relation("TeacherRooms", fields: [teacherId], references: [id])
  students  RoomStudent[]
  campaigns Campaign[]
}

model RoomStudent {
  id        Int      @id @default(autoincrement())
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId    Int
  student   User     @relation(fields: [studentId], references: [id])
  studentId Int
  joinedAt  DateTime @default(now())

  @@unique([roomId, studentId])
}

model Campaign {
  id          Int      @id @default(autoincrement())
  roomId      Int
  title       String
  description String?
  scene String? // "laboratory", "tomb", "library"
  storyPath   String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())

  // A single resource file the teacher can attach (e.g. a handout or
  // reference PDF) that students can view/download alongside the campaign.
  // Nullable trio rather than a separate table — one file per campaign is
  // all the teacher-facing UI supports (see SpellBookModal.jsx).
  attachmentFilename String?
  attachmentPath     String?
  attachmentMimeType String?

  room     Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  clues    Clue[]
  sessions CampaignSession[]
}

model Clue {
  id          Int    @id @default(autoincrement())
  campaignId  Int
  orderNumber Int
  question    String
  answer      String

  campaign Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  attempts SessionAttempt[]
}

model CampaignSession {
  id          Int       @id @default(autoincrement())
  campaignId  Int
  studentId   Int
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  totalTime   Int?      // in seconds
  rank        String?

  campaign Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  student  User            @relation(fields: [studentId], references: [id])
  attempts SessionAttempt[]
}

model LessonModule {
  id               Int      @id @default(autoincrement())
  teacherId        Int
  title            String
  originalFilename String
  filePath         String
  mimeType         String
  extractedText    String?  @db.Text
  status           String   @default("uploaded") // "uploaded" | "generated" | "failed"
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  teacher        User            @relation(fields: [teacherId], references: [id])
  generatedClues GeneratedClue[]
}

model GeneratedClue {
  id             Int      @id @default(autoincrement())
  lessonModuleId Int
  orderNumber    Int
  clueText       String   @db.Text
  answerText     String
  scene          String   // "Laboratory" | "Library" | "Tomb"
  status         String   @default("pending") // "pending" | "edited" | "approved" | "rejected"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lessonModule LessonModule @relation(fields: [lessonModuleId], references: [id])
}

model ChatConversation {
  id        Int      @id @default(autoincrement())
  teacherId Int
  createdAt DateTime @default(now())

  teacher  User          @relation(fields: [teacherId], references: [id])
  messages ChatMessage[]
}

model ChatMessage {
  id             Int      @id @default(autoincrement())
  conversationId Int
  role           String   // "user" | "model" | "function"
  content        String   @db.Text
  functionCall   Json?    // stores {name, args} when role is "model" and it's a tool call
  createdAt      DateTime @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id])
}

model SessionAttempt {
  id        Int     @id @default(autoincrement())
  sessionId Int
  clueId    Int
  attempts  Int     @default(0)
  isSolved  Boolean @default(false)

  session CampaignSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  clue    Clue            @relation(fields: [clueId], references: [id], onDelete: Cascade)
}